{{if .Interests}}
<section class="section">
    <h2>{{ .Labels.Interests }}</h2>
    <div class="interests">
        {{range .Interests}}
            <div class="interest-item">
                <span class="interest-name">{{.Name}}</span>
                {{if .Keywords}}
                <span class="interest-keywords">
                    {{range $i, $kw := .Keywords}}{{if $i}}, {{end}}{{$kw}}{{end}}
                </span>
                {{end}}
            </div>
        {{end}}
    </div>
</section>
{{end}}

{{if .Skills}}
<section class="section">
    <h2>{{.Labels.Skills}}</h2>
    <div class="skills-categories">
        {{range .Skills}}
            <div class="skill-category">
                <div class="skill-category-name">{{.Name}}</div>
                {{if .Keywords}}
                <div class="skills-list">
                    {{range .Keywords}}
                        <span class="skill-item">{{.}}</span>
                    {{end}}
                </div>
                {{end}}
            </div>
        {{end}}
    </div>
</section>
{{end}}
